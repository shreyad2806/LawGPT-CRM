    {
      "parameters": {
        "jsCode": "const legalKeywords = [\n  \"law\",\n  \"legal\",\n  \"lawyer\",\n  \"attorney\",\n  \"compliance\",\n  \"gdpr\",\n  \"privacy\",\n  \"contract\",\n  \"regulation\",\n  \"litigation\",\n  \"court\",\n  \"judge\",\n  \"legal tech\",\n  \"legal ai\",\n  \"law firm\",\n  \"employment law\",\n  \"data protection\",\n  \"governance\",\n  \"risk management\"\n];\n\nreturn items.filter(item => {\n  const text = (\n    (item.json.title || \"\") +\n    \" \" +\n    (item.json.Title || \"\") +\n    \" \" +\n    (item.json.summary || \"\") +\n    \" \" +\n    (item.json.contentSnippet || \"\")\n  ).toLowerCase();\n\n  return legalKeywords.some(keyword =>\n    text.includes(keyword.toLowerCase())\n  );\n});"
      },
